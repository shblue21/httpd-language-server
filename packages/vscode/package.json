{
  "name": "httpd-language-support",
  "displayName": "HTTPD Language Support",
  "description": "Language support for Apache HTTP Server configuration powered by httpd-language-server.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "publisher": "httpd-language-server",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["apache", "httpd", "htaccess", "language-server"],
  "activationEvents": ["onLanguage:httpd"],
  "main": "./out/client/main.cjs",
  "contributes": {
    "languages": [
      {
        "id": "httpd",
        "aliases": ["HTTPD", "Apache HTTP Server"],
        "filenames": ["httpd.conf", "apache2.conf", ".htaccess"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "httpd",
        "scopeName": "source.httpd",
        "path": "./syntaxes/httpd.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true }); require('node:fs').rmSync('syntaxes', { recursive: true, force: true }); require('node:fs').rmSync('LICENSE', { force: true })\"",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@httpd-language-server/server": "workspace:*",
    "vscode-languageclient": "~10.0.1"
  },
  "devDependencies": {
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "~3.9.2",
    "esbuild": "~0.28.1"
  },
  "vsce": {
    "dependencies": false
  }
}
